{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://github.com/blackbirdworks/semaphore/cmd/relayproxy/bootstrap/config",
    "$ref": "#/$defs/Config",
    "$defs": {
        "AdminKey": {
            "oneOf": [
                {
                    "type": "string",
                    "minLength": 1
                },
                {
                    "properties": {
                        "fromEnv": {
                            "type": "string",
                            "minLength": 1
                        },
                        "fromFile": {
                            "type": "string",
                            "minLength": 1
                        }
                    },
                    "additionalProperties": false,
                    "type": "object",
                    "maxProperties": 1,
                    "minProperties": 1
                }
            ]
        },
        "Auth": {
            "properties": {
                "adminKeys": {
                    "items": {
                        "$ref": "#/$defs/AdminKey"
                    },
                    "type": "array"
                }
            },
            "additionalProperties": false,
            "type": "object"
        },
        "Config": {
            "properties": {
                "connections": {
                    "additionalProperties": {
                        "$ref": "#/$defs/Connection"
                    },
                    "propertyNames": {
                        "not": {
                            "const": "default"
                        },
                        "pattern": "^[a-z][a-z0-9-]{0,62}$"
                    },
                    "type": "object"
                },
                "exporters": {
                    "additionalProperties": {
                        "$ref": "#/$defs/Exporter"
                    },
                    "propertyNames": {
                        "not": {
                            "const": "default"
                        },
                        "pattern": "^[a-z][a-z0-9-]{0,62}$"
                    },
                    "type": "object"
                },
                "notifiers": {
                    "additionalProperties": {
                        "$ref": "#/$defs/Notifier"
                    },
                    "propertyNames": {
                        "not": {
                            "const": "default"
                        },
                        "pattern": "^[a-z][a-z0-9-]{0,62}$"
                    },
                    "type": "object"
                },
                "controlPlane": {
                    "$ref": "#/$defs/ControlPlane"
                },
                "server": {
                    "$ref": "#/$defs/Server"
                },
                "observability": {
                    "$ref": "#/$defs/Observability"
                },
                "auth": {
                    "$ref": "#/$defs/Auth"
                },
                "version": {
                    "type": "integer",
                    "enum": [
                        2
                    ]
                }
            },
            "additionalProperties": false,
            "type": "object",
            "required": [
                "version"
            ]
        },
        "Connection": {
            "oneOf": [
                {
                    "$ref": "#/$defs/S3Connection"
                },
                {
                    "$ref": "#/$defs/KinesisConnection"
                },
                {
                    "$ref": "#/$defs/SQSConnection"
                },
                {
                    "$ref": "#/$defs/RedshiftConnection"
                }
            ]
        },
        "ControlPlane": {
            "properties": {
                "manifest": {
                    "$ref": "#/$defs/Manifest"
                },
                "connection": {
                    "type": "string"
                },
                "stateDir": {
                    "type": "string"
                }
            },
            "additionalProperties": false,
            "type": "object",
            "required": [
                "connection"
            ]
        },
        "Credentials": {
            "allOf": [
                {
                    "if": {
                        "properties": {
                            "type": {
                                "const": "assumeRole"
                            }
                        },
                        "required": [
                            "type"
                        ]
                    },
                    "then": {
                        "required": [
                            "roleArn"
                        ]
                    }
                },
                {
                    "if": {
                        "properties": {
                            "type": {
                                "const": "static"
                            }
                        },
                        "required": [
                            "type"
                        ]
                    },
                    "then": {
                        "required": [
                            "accessKeyId",
                            "secretAccessKey"
                        ]
                    }
                },
                {
                    "if": {
                        "properties": {
                            "type": {
                                "const": "webIdentity"
                            }
                        },
                        "required": [
                            "type"
                        ]
                    },
                    "then": {
                        "required": [
                            "roleArn",
                            "tokenFile"
                        ]
                    }
                }
            ],
            "properties": {
                "type": {
                    "type": "string",
                    "enum": [
                        "chain",
                        "static",
                        "assumeRole",
                        "webIdentity",
                        ""
                    ],
                    "default": "chain"
                },
                "roleArn": {
                    "type": "string"
                },
                "sessionName": {
                    "type": "string"
                },
                "externalId": {
                    "$ref": "#/$defs/Secret"
                },
                "tokenFile": {
                    "type": "string"
                },
                "accessKeyId": {
                    "$ref": "#/$defs/Secret"
                },
                "secretAccessKey": {
                    "$ref": "#/$defs/Secret"
                },
                "sessionToken": {
                    "$ref": "#/$defs/Secret"
                }
            },
            "additionalProperties": false,
            "type": "object"
        },
        "Duration": {
            "type": "string",
            "pattern": "^\\+?(?=.*[1-9])(([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ns|us|µs|μs|ms|s|m|h))+$",
            "description": "Positive duration string, for example 60s or 1m30s. Zero and negative durations are rejected."
        },
        "Exporter": {
            "allOf": [
                {
                    "if": {
                        "properties": {
                            "kind": {
                                "const": "azureBlobStorage"
                            }
                        },
                        "required": [
                            "kind"
                        ]
                    },
                    "then": {
                        "required": [
                            "container",
                            "accountName"
                        ]
                    }
                },
                {
                    "if": {
                        "properties": {
                            "kind": {
                                "const": "bigquery"
                            }
                        },
                        "required": [
                            "kind"
                        ]
                    },
                    "then": {
                        "required": [
                            "projectId",
                            "datasetId"
                        ]
                    }
                },
                {
                    "if": {
                        "properties": {
                            "kind": {
                                "const": "file"
                            }
                        },
                        "required": [
                            "kind"
                        ]
                    },
                    "then": {
                        "required": [
                            "outputDir"
                        ]
                    }
                },
                {
                    "if": {
                        "properties": {
                            "kind": {
                                "const": "googleStorage"
                            }
                        },
                        "required": [
                            "kind"
                        ]
                    },
                    "then": {
                        "required": [
                            "bucket"
                        ]
                    }
                },
                {
                    "if": {
                        "properties": {
                            "kind": {
                                "const": "kafka"
                            }
                        },
                        "required": [
                            "kind"
                        ]
                    },
                    "then": {
                        "required": [
                            "kafka"
                        ]
                    }
                },
                {
                    "if": {
                        "properties": {
                            "kind": {
                                "const": "kinesis"
                            }
                        },
                        "required": [
                            "kind"
                        ]
                    },
                    "then": {
                        "required": [
                            "connection"
                        ]
                    }
                },
                {
                    "if": {
                        "properties": {
                            "kind": {
                                "const": "pubsub"
                            }
                        },
                        "required": [
                            "kind"
                        ]
                    },
                    "then": {
                        "required": [
                            "projectId",
                            "topic"
                        ]
                    }
                },
                {
                    "if": {
                        "properties": {
                            "kind": {
                                "const": "redshift"
                            }
                        },
                        "required": [
                            "kind"
                        ]
                    },
                    "then": {
                        "required": [
                            "connection",
                            "database"
                        ]
                    }
                },
                {
                    "if": {
                        "properties": {
                            "kind": {
                                "const": "s3"
                            }
                        },
                        "required": [
                            "kind"
                        ]
                    },
                    "then": {
                        "required": [
                            "connection"
                        ]
                    }
                },
                {
                    "if": {
                        "properties": {
                            "kind": {
                                "const": "sqs"
                            }
                        },
                        "required": [
                            "kind"
                        ]
                    },
                    "then": {
                        "required": [
                            "connection"
                        ]
                    }
                },
                {
                    "if": {
                        "properties": {
                            "kind": {
                                "const": "webhook"
                            }
                        },
                        "required": [
                            "kind"
                        ]
                    },
                    "then": {
                        "required": [
                            "endpointUrl"
                        ]
                    }
                }
            ],
            "properties": {
                "meta": {
                    "additionalProperties": {
                        "type": "string"
                    },
                    "type": "object"
                },
                "headers": {
                    "additionalProperties": {
                        "$ref": "#/$defs/Secret"
                    },
                    "type": "object"
                },
                "flushInterval": {
                    "$ref": "#/$defs/Duration",
                    "default": "60s"
                },
                "maxEventInMemory": {
                    "type": "integer",
                    "minimum": 1,
                    "default": 100000
                },
                "kafka": {
                    "$ref": "#/$defs/KafkaSettings"
                },
                "clusterIdentifier": {
                    "type": "string"
                },
                "streamName": {
                    "type": "string"
                },
                "eventType": {
                    "type": "string"
                },
                "format": {
                    "type": "string",
                    "enum": [
                        "json",
                        "csv",
                        "parquet",
                        ""
                    ]
                },
                "filename": {
                    "type": "string"
                },
                "csvTemplate": {
                    "type": "string"
                },
                "parquetCompressionCodec": {
                    "type": "string"
                },
                "path": {
                    "type": "string"
                },
                "outputDir": {
                    "type": "string"
                },
                "logFormat": {
                    "type": "string"
                },
                "tracerName": {
                    "type": "string"
                },
                "container": {
                    "type": "string"
                },
                "bucket": {
                    "type": "string"
                },
                "accountName": {
                    "type": "string"
                },
                "streamArn": {
                    "type": "string"
                },
                "connection": {
                    "type": "string"
                },
                "queueUrl": {
                    "type": "string"
                },
                "projectId": {
                    "type": "string"
                },
                "datasetId": {
                    "type": "string"
                },
                "topic": {
                    "type": "string"
                },
                "tableName": {
                    "type": "string"
                },
                "database": {
                    "type": "string"
                },
                "kind": {
                    "type": "string",
                    "enum": [
                        "file",
                        "webhook",
                        "log",
                        "s3",
                        "kinesis",
                        "googleStorage",
                        "sqs",
                        "kafka",
                        "pubsub",
                        "bigquery",
                        "redshift",
                        "azureBlobStorage",
                        "opentelemetry"
                    ]
                },
                "workgroupName": {
                    "type": "string"
                },
                "dbUser": {
                    "type": "string"
                },
                "secretArn": {
                    "type": "string"
                },
                "googleCredentials": {
                    "$ref": "#/$defs/Secret"
                },
                "accountKey": {
                    "$ref": "#/$defs/Secret"
                },
                "secret": {
                    "$ref": "#/$defs/Secret"
                },
                "endpointUrl": {
                    "$ref": "#/$defs/Secret"
                },
                "autoMigrate": {
                    "type": "boolean"
                }
            },
            "additionalProperties": false,
            "type": "object",
            "required": [
                "kind"
            ]
        },
        "KafkaSettings": {
            "properties": {
                "topic": {
                    "type": "string"
                },
                "addresses": {
                    "items": {
                        "type": "string"
                    },
                    "type": "array"
                }
            },
            "additionalProperties": false,
            "type": "object",
            "required": [
                "topic",
                "addresses"
            ]
        },
        "KinesisConnection": {
            "properties": {
                "credentials": {
                    "$ref": "#/$defs/Credentials"
                },
                "timeouts": {
                    "$ref": "#/$defs/Timeouts"
                },
                "retry": {
                    "$ref": "#/$defs/Retry"
                },
                "endpoint": {
                    "type": "string"
                },
                "region": {
                    "type": "string"
                },
                "type": {
                    "type": "string",
                    "enum": [
                        "kinesis"
                    ]
                },
                "stream": {
                    "type": "string"
                }
            },
            "additionalProperties": false,
            "type": "object",
            "required": [
                "type"
            ]
        },
        "Listener": {
            "properties": {
                "name": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]{0,62}$"
                },
                "address": {
                    "type": "string"
                },
                "role": {
                    "type": "string",
                    "enum": [
                        "api",
                        "ops",
                        ""
                    ],
                    "default": "api"
                },
                "protocols": {
                    "items": {
                        "type": "string",
                        "enum": [
                            "http1",
                            "h2c"
                        ]
                    },
                    "type": "array",
                    "uniqueItems": true
                }
            },
            "additionalProperties": false,
            "type": "object",
            "required": [
                "name"
            ]
        },
        "Logging": {
            "properties": {
                "level": {
                    "type": "string",
                    "enum": [
                        "debug",
                        "info",
                        "warn",
                        "error",
                        ""
                    ],
                    "default": "info"
                },
                "format": {
                    "type": "string",
                    "enum": [
                        "json",
                        "text",
                        ""
                    ],
                    "default": "json"
                }
            },
            "additionalProperties": false,
            "type": "object"
        },
        "Manifest": {
            "properties": {
                "pollInterval": {
                    "$ref": "#/$defs/Duration",
                    "default": "60s"
                },
                "jitter": {
                    "type": "number",
                    "maximum": 1,
                    "minimum": 0,
                    "default": 0.1
                },
                "maxObjects": {
                    "type": "integer",
                    "minimum": 1,
                    "default": 20000
                },
                "key": {
                    "type": "string"
                },
                "channel": {
                    "type": "string",
                    "default": "stable"
                }
            },
            "additionalProperties": false,
            "type": "object"
        },
        "Metrics": {
            "properties": {
                "enabled": {
                    "type": "boolean",
                    "default": true
                },
                "legacyNames": {
                    "type": "boolean"
                },
                "perFlagLabels": {
                    "type": "boolean"
                }
            },
            "additionalProperties": false,
            "type": "object"
        },
        "Notifier": {
            "allOf": [
                {
                    "if": {
                        "properties": {
                            "kind": {
                                "const": "discord"
                            }
                        },
                        "required": [
                            "kind"
                        ]
                    },
                    "then": {
                        "required": [
                            "webhookUrl"
                        ]
                    }
                },
                {
                    "if": {
                        "properties": {
                            "kind": {
                                "const": "microsoftteams"
                            }
                        },
                        "required": [
                            "kind"
                        ]
                    },
                    "then": {
                        "required": [
                            "webhookUrl"
                        ]
                    }
                },
                {
                    "if": {
                        "properties": {
                            "kind": {
                                "const": "slack"
                            }
                        },
                        "required": [
                            "kind"
                        ]
                    },
                    "then": {
                        "required": [
                            "webhookUrl"
                        ]
                    }
                },
                {
                    "if": {
                        "properties": {
                            "kind": {
                                "const": "webhook"
                            }
                        },
                        "required": [
                            "kind"
                        ]
                    },
                    "then": {
                        "required": [
                            "endpointUrl"
                        ]
                    }
                }
            ],
            "properties": {
                "meta": {
                    "additionalProperties": {
                        "type": "string"
                    },
                    "type": "object"
                },
                "headers": {
                    "additionalProperties": {
                        "$ref": "#/$defs/Secret"
                    },
                    "type": "object"
                },
                "kind": {
                    "type": "string",
                    "enum": [
                        "slack",
                        "microsoftteams",
                        "webhook",
                        "discord"
                    ]
                },
                "webhookUrl": {
                    "$ref": "#/$defs/Secret"
                },
                "endpointUrl": {
                    "$ref": "#/$defs/Secret"
                },
                "secret": {
                    "$ref": "#/$defs/Secret"
                }
            },
            "additionalProperties": false,
            "type": "object",
            "required": [
                "kind"
            ]
        },
        "Observability": {
            "properties": {
                "logging": {
                    "$ref": "#/$defs/Logging"
                },
                "metrics": {
                    "$ref": "#/$defs/Metrics"
                },
                "tracing": {
                    "$ref": "#/$defs/Tracing"
                }
            },
            "additionalProperties": false,
            "type": "object"
        },
        "Poll": {
            "properties": {
                "interval": {
                    "$ref": "#/$defs/Duration",
                    "default": "60s"
                },
                "jitter": {
                    "type": "number",
                    "maximum": 1,
                    "minimum": 0,
                    "default": 0.1
                }
            },
            "additionalProperties": false,
            "type": "object"
        },
        "RedshiftConnection": {
            "properties": {
                "credentials": {
                    "$ref": "#/$defs/Credentials"
                },
                "timeouts": {
                    "$ref": "#/$defs/Timeouts"
                },
                "retry": {
                    "$ref": "#/$defs/Retry"
                },
                "endpoint": {
                    "type": "string"
                },
                "region": {
                    "type": "string"
                },
                "type": {
                    "type": "string",
                    "enum": [
                        "redshift"
                    ]
                }
            },
            "additionalProperties": false,
            "type": "object",
            "required": [
                "type"
            ]
        },
        "Retry": {
            "properties": {
                "maxAttempts": {
                    "type": "integer",
                    "maximum": 20,
                    "minimum": 1,
                    "default": 3
                },
                "maxBackoff": {
                    "$ref": "#/$defs/Duration",
                    "default": "20s"
                }
            },
            "additionalProperties": false,
            "type": "object"
        },
        "S3Connection": {
            "properties": {
                "credentials": {
                    "$ref": "#/$defs/Credentials"
                },
                "timeouts": {
                    "$ref": "#/$defs/Timeouts"
                },
                "retry": {
                    "$ref": "#/$defs/Retry"
                },
                "endpoint": {
                    "type": "string"
                },
                "region": {
                    "type": "string"
                },
                "poll": {
                    "$ref": "#/$defs/Poll"
                },
                "type": {
                    "type": "string",
                    "enum": [
                        "s3"
                    ]
                },
                "bucket": {
                    "type": "string"
                },
                "requestChecksumCalculation": {
                    "type": "string",
                    "enum": [
                        "whenSupported",
                        "whenRequired",
                        ""
                    ],
                    "default": "whenSupported"
                },
                "responseChecksumValidation": {
                    "type": "string",
                    "enum": [
                        "whenSupported",
                        "whenRequired",
                        ""
                    ],
                    "default": "whenSupported"
                },
                "pathStyle": {
                    "type": "boolean"
                }
            },
            "additionalProperties": false,
            "type": "object",
            "required": [
                "type"
            ]
        },
        "SQSConnection": {
            "properties": {
                "credentials": {
                    "$ref": "#/$defs/Credentials"
                },
                "timeouts": {
                    "$ref": "#/$defs/Timeouts"
                },
                "retry": {
                    "$ref": "#/$defs/Retry"
                },
                "endpoint": {
                    "type": "string"
                },
                "region": {
                    "type": "string"
                },
                "type": {
                    "type": "string",
                    "enum": [
                        "sqs"
                    ]
                },
                "queueUrl": {
                    "type": "string"
                }
            },
            "additionalProperties": false,
            "type": "object",
            "required": [
                "type"
            ]
        },
        "Secret": {
            "properties": {
                "fromEnv": {
                    "type": "string",
                    "minLength": 1
                },
                "fromFile": {
                    "type": "string",
                    "minLength": 1
                }
            },
            "additionalProperties": false,
            "type": "object",
            "maxProperties": 1,
            "minProperties": 1
        },
        "Server": {
            "properties": {
                "unixSocketPath": {
                    "type": "string"
                },
                "listeners": {
                    "items": {
                        "$ref": "#/$defs/Listener"
                    },
                    "type": "array"
                }
            },
            "additionalProperties": false,
            "type": "object"
        },
        "Timeouts": {
            "properties": {
                "connect": {
                    "$ref": "#/$defs/Duration",
                    "default": "10s"
                },
                "request": {
                    "$ref": "#/$defs/Duration",
                    "default": "30s"
                }
            },
            "additionalProperties": false,
            "type": "object"
        },
        "Tracing": {
            "properties": {
                "otlpEndpoint": {
                    "type": "string"
                },
                "serviceName": {
                    "type": "string",
                    "default": "semaphore"
                },
                "sampler": {
                    "type": "string",
                    "enum": [
                        "always_on",
                        "always_off",
                        "traceidratio",
                        "parentbased_always_on",
                        "parentbased_always_off",
                        "parentbased_traceidratio",
                        ""
                    ],
                    "default": "parentbased_always_off"
                }
            },
            "additionalProperties": false,
            "type": "object"
        }
    },
    "title": "Semaphore relay proxy bootstrap file, version 2"
}
