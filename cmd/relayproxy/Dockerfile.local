# Dockerfile to build the relay proxy image from source.
#
# The other Dockerfiles in this directory (DockerfileGoreleaser*) are consumed by
# GoReleaser during a release: they only COPY a binary that has already been
# cross-compiled, so they cannot be built by hand. This one compiles the relay
# proxy itself and is the one to use locally.
#
# Build it with:
#   make build-relayproxy-docker
#
# ...or directly, from the repository root (the build context must be the root):
#   docker build -f cmd/relayproxy/Dockerfile.local -t semaphore:local .
#
# Run it (the example bootstrap file and its file store, read from the working directory):
#   docker run -p 1031:1031 -w /semaphore \
#     -v $(pwd)/cmd/relayproxy/testdata/dockerhub-example:/semaphore:ro \
#     semaphore:local --config bootstrap.yaml

FROM golang:1.27 AS build
WORKDIR /src
COPY . .
# GOWORK=off mirrors what CI does (see Makefile): the root module contains
# modules/core and rules/, so no go.work is needed here.
ARG VERSION=localdev
RUN CGO_ENABLED=0 GOWORK=off go build \
    -ldflags="-s -w -X main.version=${VERSION}" \
    -o /out/semaphore ./cmd/relayproxy

FROM gcr.io/distroless/static-debian13:nonroot@sha256:8ce6dd87e9823c5b48dcfb2c8604714ccb351ce59607327bcc4957448da279b5
COPY --from=build /out/semaphore /usr/local/bin/semaphore
COPY LICENSE NOTICE /licenses/
COPY rules/LICENSE /licenses/rules-LICENSE
COPY internal/koanfhttpprovider/LICENSE /licenses/koanfhttpprovider-LICENSE
EXPOSE 1031
USER 65532:65532
ENTRYPOINT ["/usr/local/bin/semaphore"]
